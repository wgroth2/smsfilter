    <string name="permission_status_not_requested">No solicitado</string>
    <string name="permission_permanently_denied">Android ya no mostrará la solicitud de permiso para esto. Concédelo en los ajustes de la aplicación y vuelve aquí — la aplicación lo detectará automáticamente.</string>
    <string name="permission_contacts_denied_warning">El acceso a contactos está denegado, así que todos los remitentes se tratarán como desconocidos. Puedes concederlo más tarde en Ajustes.</string>
    <string name="permission_request_all">Conceder permisos</string>

    <string name="onboarding_connection_test_title">Prueba de conexión</string>
    <string name="onboarding_connection_test_body">Comprobando que la aplicación puede leer tus contactos para reconocer a las personas que conoces.</string>
    <string name="onboarding_connection_test_run">Repetir la prueba</string>
    <string name="connection_contacts_checking">Comprobando Google Contacts…</string>
    <string name="connection_contacts_accessible">Google Contacts: Accesible (%1$d contactos encontrados)</string>
    <string name="connection_contacts_denied">Google Contacts: No accesible — permiso denegado. Puedes concederlo más tarde desde Ajustes.</string>
    <string name="onboarding_auto_reply_disclosure">La respuesta automática está ACTIVADA por defecto — SMS Filter enviará automáticamente una respuesta de una sola palabra, \"stop\" o \"end\", cuando detecte un mensaje de baja de un remitente desconocido. Puedes cambiar al modo de solo detección en cualquier momento desde Ajustes.</string>

    <string name="onboarding_hubspot_not_here">HubSpot CRM es opcional y no se configura aquí. Se te ofrecerá una vez después de la configuración, y siempre puedes conectarlo más tarde desde Ajustes.</string>

