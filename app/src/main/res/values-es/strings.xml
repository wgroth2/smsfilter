    <string name="onboarding_welcome_title">SMS Filter</string>
    <string name="onboarding_welcome_body">SMS Filter vigila los mensajes de texto entrantes en busca de solicitudes de baja de remitentes que no están en tus contactos, y responde automáticamente para que dejen de escribirte.\n\nLos mensajes de personas que conoces siempre se ignoran. Tus contactos nunca se copian ni se suben — cada comprobación ocurre en este teléfono, en tiempo real.</string>
    <string name="onboarding_get_started">Comenzar</string>

    <string name="onboarding_permissions_title">Permisos</string>
    <string name="onboarding_permissions_body">SMS Filter necesita estos permisos para funcionar. No puedes continuar hasta que se concedan los obligatorios.</string>
    <string name="onboarding_permissions_required_header">Obligatorios</string>
    <string name="onboarding_permissions_optional_header">Recomendados</string>

    <string name="permission_name_receive_sms">Recibir SMS</string>
    <string name="permission_reason_receive_sms">Permite que la aplicación vea los mensajes entrantes para detectar solicitudes de baja. Sin esto, la aplicación no puede funcionar.</string>
    <string name="permission_name_send_sms">Enviar SMS</string>
    <string name="permission_reason_send_sms">Permite que la aplicación envíe en tu nombre la respuesta de una sola palabra: \"stop\" o \"end\".</string>
    <string name="permission_name_post_notifications">Notificaciones</string>
    <string name="permission_reason_post_notifications">Permite que la aplicación te avise cuando haya detectado una solicitud de baja.</string>
    <string name="permission_name_read_contacts">Leer contactos</string>
    <string name="permission_reason_read_contacts">Permite que la aplicación reconozca a las personas que conoces para no responderles nunca. Si lo omites, todos los remitentes se tratarán como desconocidos.</string>

