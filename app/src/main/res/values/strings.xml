    <string name="onboarding_welcome_title">SMS Filter</string>
    <string name="onboarding_welcome_body">SMS Filter watches incoming text messages for opt-out requests from senders who are not in your contacts, and replies automatically so you stop hearing from them.\n\nMessages from people you know are always ignored. Your contacts are never copied or uploaded — every check happens on this phone, in real time.</string>
    <string name="onboarding_get_started">Get Started</string>

    <string name="onboarding_permissions_title">Permissions</string>
    <string name="onboarding_permissions_body">SMS Filter needs these permissions to work. You cannot continue until the required ones are granted.</string>
    <string name="onboarding_permissions_required_header">Required</string>
    <string name="onboarding_permissions_optional_header">Recommended</string>

    <string name="permission_name_receive_sms">Receive SMS</string>
    <string name="permission_reason_receive_sms">Lets the app see incoming messages so it can detect opt-out requests. Without this the app cannot function.</string>
    <string name="permission_name_send_sms">Send SMS</string>
    <string name="permission_reason_send_sms">Lets the app send the one-word \"stop\" or \"end\" reply on your behalf.</string>
    <string name="permission_name_post_notifications">Notifications</string>
    <string name="permission_reason_post_notifications">Lets the app tell you when it has detected an opt-out request.</string>
    <string name="permission_name_read_contacts">Read Contacts</string>
    <string name="permission_reason_read_contacts">Lets the app recognise people you know so it never replies to them. If you skip this, every sender is treated as unknown.</string>

    <string name="permission_action_grant">Grant</string>
