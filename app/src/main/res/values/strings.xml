    <string name="permission_contacts_denied_warning">Contacts access is denied, so every sender will be treated as unknown. You can grant it later in Settings.</string>
    <string name="permission_request_all">Grant permissions</string>

    <string name="onboarding_connection_test_title">Connection Test</string>
    <string name="onboarding_connection_test_body">Checking that the app can read your contacts to recognise people you know.</string>
