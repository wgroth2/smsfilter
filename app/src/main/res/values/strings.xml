    <!-- Onboarding step 3: Notification Access -->
    <string name="onboarding_notification_access_title">Notification Access</string>
    <string name="onboarding_notification_access_body">Political and promotional texts often arrive as MMS picture messages (flyers) or RCS chats rather than plain SMS.</string>
    <string name="onboarding_notification_access_why">Android only lets an app that is not your default messaging app see those through Notification Access, a separate permission you grant in system settings.</string>
    <string name="onboarding_notification_access_return_note">You will leave the app briefly. When you come back, this step updates on its own — no need to tap anything.</string>
    <string name="onboarding_notification_access_skip_note">If you skip this: SMS Filter still filters standard cellular SMS. MMS picture texts and RCS chats will not be detected until you enable Notification Access from Settings.</string>
    <string name="onboarding_skip_for_now">Skip for now</string>

