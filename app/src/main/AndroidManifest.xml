<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime permissions, requested by the onboarding wizard (Phase 6). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Install-time permissions. FOREGROUND_SERVICE backs the expedited worker's
         getForegroundInfo() fallback on API < 31; it is not a long-running service.
         READ_SMS is deliberately NOT requested: the receiver reads the broadcast PDUs
         directly and never queries the SMS content provider. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Telephony hardware is not required, allowing installation on tablets and ChromeOS. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".SmsFilterApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsFilter">

        <!-- Forward declaration: implemented in Phase 6. The APK builds and installs
             before then, but will crash on launch until MainActivity exists. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmsFilter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Forward declaration: implemented in Phase 4. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Notification listener for RCS opt-out detection from supported messaging apps. -->
        <service
            android:name=".receiver.RcsNotificationListenerService"
            android:exported="true"
            android:label="@string/rcs_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Attach the dataSync foreground service type to WorkManager's own service so
             expedited-work fallback on API < 31 cannot raise a SecurityException under
             the Android 14/15 foreground service restrictions. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Disable WorkManager's default self-initialization. SmsLookupWorker is a
             @HiltWorker, so the factory must come from Hilt via Configuration.Provider
             in SmsFilterApplication; without this removal the worker is constructed
             reflectively without its dependencies and crashes at runtime. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Lets AppCompat persist the per-app language on API levels below 33, where the platform
             has no per-app locale store of its own. Disabled as a component: it is a metadata
             holder that AppCompat reads, never a service that runs. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
