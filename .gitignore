# Built artifacts
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (contains local paths, secrets, etc.)
local.properties

# Log files
*.log

# Android Studio Local files and settings
.navigation/
captures/
.externalNativeBuild/
.cxx/
cmake-build-*/
code-review/
# IDE project files. The whole .idea directory is ignored: this is a solo repository,
# and most of its contents (deployment target, open tabs, window layout) change on every
# debug session without carrying any information worth versioning.
.idea/
*.iml
.vscode/

# Keystore and certificate files. Release signing is supplied through environment
# variables, so no credential material should ever reach the repository.
*.jks
*.keystore
*.p12
*.p8
*.pem

# Secret-bearing configuration. The HubSpot token is stored in EncryptedSharedPreferences
# on-device, but these are the conventional file names a future change might introduce.
.env
.env.*
secrets.properties
keystore.properties
key.properties
signing.properties

# Device crash reports
*.hprof

# OS generated files
.DS_Store
Thumbs.db

# Editor swap and backup files
*.swp
*~
.*.sw?

# Kotlin build session data
.kotlin/

# Gradle wrapper distribution cache (the wrapper scripts/jar ARE tracked)
gradle-app.setting
.gradletasknamecache

# Chat session identifier
chat.id

# PDF exports
pdf/

